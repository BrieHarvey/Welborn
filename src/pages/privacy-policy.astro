---
import BaseLayout from '../layouts/BaseLayout.astro';
import { practice, primaryLocation, cityLine } from '../data/site.js';

// Update this date whenever the policy below is changed.
const lastUpdated = 'August 14, 2026';

const sections = [
  {
    heading: 'What this policy covers',
    paragraphs: [
      `This policy explains what happens to information submitted through ${practice.name.toLowerCase() === practice.name ? practice.name : practice.name}’s website. It applies to this website only. It does not cover the separate records, consents and notices that govern your care as a patient of the practice — those are provided to you at the office.`,
    ],
  },
  {
    heading: 'This website is not a patient portal',
    paragraphs: [
      'The appointment request form on this website is a scheduling convenience, not a secure medical messaging system. It is not a HIPAA-compliant channel, and it should not be used to send detailed medical history, test results, images, insurance identifiers or any other sensitive health information.',
      'Please send only what is needed to arrange an appointment: your name, how to reach you, and a general description of the problem. Anything more detailed is better discussed by phone or in person.',
      'The form is not monitored continuously and is never monitored for medical emergencies. If you are experiencing a medical emergency, call 911 or go to the nearest emergency room.',
    ],
  },
  {
    heading: 'Information collected',
    paragraphs: [
      'When you submit the appointment request form, the practice receives the information you typed into it: your name, phone number, email address, your preferred method of contact and office, the general reason for your visit, and any message you added.',
      'As with any website, the hosting provider automatically records basic technical information — such as IP address, browser type and the pages requested — in server logs used for security and reliability. This website does not set advertising cookies, does not use tracking pixels, and does not run third-party analytics.',
    ],
  },
  {
    heading: 'How the information is used',
    paragraphs: [
      'Information you submit is used solely to respond to your request and to arrange an appointment. It is not sold, rented, or shared for advertising or marketing purposes, and it is not used to build an advertising profile.',
      'Information may be shared only with the service providers required to deliver the message to the office, and only to the extent needed to do so — for example, the website host and the email delivery service.',
    ],
  },
  {
    heading: 'Third-party services',
    paragraphs: [
      'This website is hosted on Cloudflare Pages. Cloudflare processes requests to the site and maintains its own logs as part of providing that service.',
      'The contact page offers an interactive Google Map. It does not load automatically — nothing is requested from Google until you choose to load it by clicking the button. If you do, Google receives the request and applies its own privacy policy.',
    ],
  },
  {
    heading: 'Retention',
    paragraphs: [
      'Appointment requests are retained by the office for as long as needed to respond and to maintain ordinary business records. If your request becomes part of your patient record, it is handled under the practice’s medical records policies rather than this website policy.',
    ],
  },
  {
    heading: 'Your choices',
    paragraphs: [
      'You are never required to use the website form. You can reach the office by telephone at any time during business hours, and by mail at the address below.',
      'To ask what website-submitted information the practice holds about you, to correct it, or to request its deletion, contact the office using the details below.',
    ],
  },
  {
    heading: 'Children',
    paragraphs: [
      'This website is intended for adults. Requests concerning a child should be submitted by a parent or legal guardian.',
    ],
  },
  {
    heading: 'Changes to this policy',
    paragraphs: [
      'This policy may be updated from time to time. The date at the top of the page shows when it was last revised.',
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy | Welborn Orthopedics"
  description="How Welborn Orthopedics handles information submitted through this website, including the appointment request form."
  canonical="/privacy-policy"
>
  <section class="legal-page">
    <div class="container">
      <div class="legal">
        <header class="legal__header">
          <span class="eyebrow">Legal</span>
          <h1>Privacy Policy</h1>
          <p class="legal__updated">Last updated {lastUpdated}</p>
        </header>

        {
          sections.map((section) => (
            <section class="legal__section">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }

        <section class="legal__section">
          <h2>Contact</h2>
          <address class="legal__address">
            {practice.name}<br />
            {primaryLocation.street}<br />
            {cityLine(primaryLocation)}<br />
            <a href={`tel:${practice.phoneHref}`}>{practice.phone}</a><br />
            <a href={`mailto:${practice.email}`}>{practice.email}</a>
          </address>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-block: clamp(2.75rem, 2rem + 4vw, 5rem) clamp(4rem, 3rem + 4vw, 7rem);
  }

  .legal {
    max-width: 42rem;
  }

  .legal__header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .legal__header h1 {
    font-size: var(--step-h1);
    letter-spacing: -0.028em;
  }

  .legal__updated {
    margin-top: 0.85rem;
    font-size: var(--step-small);
    color: var(--ink-3);
  }

  .legal__section {
    margin-top: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
  }

  .legal__section h2 {
    font-size: var(--step-h3);
  }

  .legal__section p {
    margin-top: 0.9rem;
    line-height: 1.75;
  }

  .legal__address {
    margin-top: 0.9rem;
    font-style: normal;
    line-height: 1.8;
  }
</style>
