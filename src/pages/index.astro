---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import CredentialStrip from '../components/CredentialStrip.astro';
import CtaSection from '../components/CtaSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { hero, about, continuity } from '../data/content.js';
import { regions, entriesByRegion } from '../data/conditions.js';
import { insurance } from '../data/patient-resources.js';
import { practice, locations, officeHours, cityLine } from '../data/site.js';

const pinole = locations.find((l) => l.id === 'pinole')!;
---

<BaseLayout
  title="Welborn Orthopedics | Orthopaedic Surgeon in Pinole & the East Bay"
  description="Board-certified orthopaedic surgeon J. Hearst Welborn, MD treats hand, shoulder, knee and hip conditions, fractures and injuries in Pinole, California."
  canonical="/"
>
  <!-- ==================== HERO ====================
       The hero and the credibility band below share one background and are
       separated only by a hairline, so the page opens as a single composition
       rather than a headline followed by a detached strip. -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">
          <span class="hero__doctor">{practice.doctor.fullName}</span>
          <span class="hero__rule" aria-hidden="true"></span>
          <span>{practice.doctor.specialty}</span>
        </p>

        <h1 class="hero__headline" id="hero-heading">{hero.headline}</h1>
        <p class="hero__subhead">{hero.subhead}</p>

        <div class="btn-row hero__buttons">
          <Button href={hero.primaryButton.href}>{hero.primaryButton.label}</Button>
          <Button href={hero.secondaryButton.href} variant="secondary">
            {hero.secondaryButton.label}
          </Button>
        </div>

        <p class="hero__place">
          {pinole.street}, {cityLine(pinole)}
          <a class="hero__call" href={`tel:${practice.phoneHref}`}>{practice.phone}</a>
        </p>
      </div>

      <div class="hero__media">
        <PhotoFrame
          alt={hero.imageAlt}
          note="Hero photograph — Dr. Welborn with a patient, or an environmental portrait in the Pinole office. Portrait orientation, approximately 1200 × 1500. See PhotoFrame.astro."
          caption={practice.doctor.fullName}
          captionSub={practice.doctor.specialty}
          ratio="4 / 5"
          eager
        />
      </div>
    </div>

    <!-- ==================== CREDIBILITY ==================== -->
    <CredentialStrip />
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="section about" aria-labelledby="about-heading">
    <div class="container about__inner">
      <div class="about__media reveal">
        <PhotoFrame
          alt={about.imageAlt}
          note="Portrait of Dr. Welborn. Editorial, natural light, portrait orientation, approximately 1200 × 1500."
          ratio="4 / 5"
        />
        <ul class="about__credentials">
          <li>
            <span class="about__credential-value">30+</span>
            <span class="about__credential-label">Years in practice</span>
          </li>
          <li>
            <span class="about__credential-value">Private practice</span>
            <span class="about__credential-label">Physician-led care</span>
          </li>
        </ul>
      </div>

      <div class="about__copy reveal" style="--reveal-delay: 90ms">
        <span class="eyebrow">{about.eyebrow}</span>
        <h2 class="about__headline" id="about-heading">{about.headline}</h2>
        <div class="about__body">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="link-arrow about__link" href={about.link.href}>{about.link.label}</a>
      </div>
    </div>
  </section>

  <!-- ==================== CONTINUITY OF CARE ==================== -->
  <section class="section section--tint section--rule" aria-labelledby="continuity-heading">
    <div class="container">
      <div class="continuity">
        <div class="continuity__lead reveal">
          <span class="eyebrow">{continuity.eyebrow}</span>
          <h2 id="continuity-heading">{continuity.headline}</h2>
          <p class="lead continuity__body">{continuity.body}</p>
        </div>

        <ol class="continuity__points">
          {
            continuity.points.map((point, index) => (
              <li class="continuity__point reveal" style={`--reveal-delay: ${index * 90}ms`}>
                <span class="continuity__num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="continuity__point-title">{point.title}</h3>
                <p class="continuity__point-body">{point.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ==================== AREAS OF CARE ==================== -->
  <section class="section" aria-labelledby="areas-heading">
    <div class="container">
      <SectionHeader
        eyebrow="Conditions & treatments"
        title="Areas of care"
        intro="From nerve compression in the hand to joint replacement of the knee, evaluation begins with an accurate diagnosis — and very often with treatment that does not involve surgery."
        id="areas-heading"
        class="reveal"
      />

      <div class="grid grid--2 areas">
        {
          regions.map((region, index) => (
            <article class="area reveal" style={`--reveal-delay: ${(index % 2) * 80}ms`}>
              <h3 class="area__title">
                <a href={`/conditions-treatments#${region.id}`}>{region.name}</a>
              </h3>
              <p class="area__blurb">{region.blurb}</p>
              <ul class="area__list">
                {entriesByRegion(region.id)
                  .slice(0, 4)
                  .map((entry) => (
                    <li>{entry.title}</li>
                  ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="areas__cta reveal">
        <Button href="/conditions-treatments" variant="secondary">
          View all conditions &amp; treatments
        </Button>
      </div>
    </div>
  </section>

  <!-- ==================== INSURANCE ==================== -->
  <section class="section section--tight section--tint section--rule" id="insurance" aria-labelledby="insurance-heading">
    <div class="container">
      <div class="insurance reveal">
        <div class="insurance__copy">
          <span class="eyebrow">{insurance.eyebrow}</span>
          <h2 id="insurance-heading">{insurance.headline}</h2>
          <p class="insurance__intro">{insurance.intro}</p>
          <div class="btn-row insurance__buttons">
            <Button href={`tel:${practice.phoneHref}`}>
              {insurance.ctaLabel} — {practice.phone}
            </Button>
            <Button href="/patient-resources#insurance" variant="secondary">
              Insurance details
            </Button>
          </div>
        </div>

        <div class="insurance__plans">
          <h3 class="insurance__plans-title">Accepted plans include</h3>
          <ul class="insurance__list">
            {insurance.plans.map((plan) => <li>{plan}</li>)}
          </ul>
          <p class="fine insurance__disclaimer">{insurance.disclaimer}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LOCATIONS ==================== -->
  <section class="section section--tight" aria-labelledby="locations-heading">
    <div class="container">
      <div class="locations reveal">
        <div class="locations__header">
          <span class="eyebrow">The office</span>
          <h2 id="locations-heading">Seeing patients across the East Bay</h2>
        </div>

        <div class="locations__grid">
          <div class="locations__item">
            <h3>{pinole.name}</h3>
            <address>
              {pinole.street}<br />
              {cityLine(pinole)}
            </address>
            <a class="link-arrow" href="/contact">Directions &amp; details</a>
          </div>

          <div class="locations__item">
            <h3>Contact</h3>
            <address>
              <a href={`tel:${practice.phoneHref}`}>{practice.phone}</a><br />
              <a href={`mailto:${practice.email}`}>{practice.email}</a>
            </address>
            <a class="link-arrow" href="/contact#request-an-appointment">Request an appointment</a>
          </div>

          <div class="locations__item">
            <h3>Office hours</h3>
            {
              officeHours.verified ? (
                <address>
                  {officeHours.days.map((day) => (
                    <Fragment>
                      {`${day.label}: ${day.hours || '—'}`}
                      <br />
                    </Fragment>
                  ))}
                </address>
              ) : (
                <p class="locations__note">{officeHours.note}</p>
              )
            }
            <a class="link-arrow" href={`tel:${practice.phoneHref}`}>Call {practice.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaSection />
</BaseLayout>

<style>
  /* ---------- Hero ----------
     The hero and the credibility band share this background, so the page opens
     as one composition. The band supplies its own top hairline. */
  .hero {
    /* The decorative wash behind the image frame bleeds past the frame by
       design; clip it here so it can never widen the page. */
    overflow-x: clip;
    padding-top: clamp(2.5rem, 1.6rem + 3.4vw, 4.75rem);
    background:
      radial-gradient(58% 70% at 82% 4%, rgba(13, 146, 184, 0.1) 0%, transparent 62%),
      radial-gradient(48% 60% at 96% 52%, rgba(122, 188, 141, 0.09) 0%, transparent 66%),
      linear-gradient(180deg, var(--surface) 0%, var(--bg) 62%);
  }

  .hero__inner {
    display: grid;
    /* The image takes a little under half the width — substantial enough to
       carry the page without crowding the headline. */
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(2.5rem, 1.2rem + 4.5vw, 5rem);
    align-items: center;
    padding-bottom: clamp(2.75rem, 1.8rem + 3.6vw, 5rem);
  }

  /* ---- Eyebrow: the surgeon's name, which the hero did not previously carry ---- */
  .hero__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    font-size: var(--step-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero__doctor {
    color: var(--accent);
  }

  .hero__rule {
    width: 1.75rem;
    height: 1px;
    background: var(--line-strong);
    opacity: 0.55;
  }

  /* ---- Headline ----
     Deliberately smaller than the old display size. At 4.4rem it dominated the
     screen and pushed the buttons below the fold; the weight of the page now
     comes from the composition rather than from type size alone. */
  .hero__headline {
    margin-top: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.032em;
    text-wrap: balance;
    max-width: 15ch;
  }

  .hero__subhead {
    margin-top: clamp(1.1rem, 0.9rem + 0.7vw, 1.5rem);
    font-size: var(--step-lead);
    line-height: 1.62;
    color: var(--ink-3);
    max-width: 32rem;
  }

  .hero__buttons {
    margin-top: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
  }

  /* ---- The office line under the buttons ---- */
  .hero__place {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    padding-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-top: 1px solid var(--line);
    max-width: 32rem;
    font-size: var(--step-small);
    color: var(--ink-3);
  }

  .hero__call {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid var(--accent-tint-2);
    transition: border-color var(--dur) var(--ease);
  }

  .hero__call:hover {
    border-bottom-color: var(--accent);
  }

  .hero__media {
    position: relative;
    /* Keeps the frame from growing unreadably tall on very wide screens. */
    max-width: 30rem;
    margin-left: auto;
    width: 100%;
  }

  /* ---- Responsive ---- */
  @media (max-width: 62rem) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: clamp(2.25rem, 1.8rem + 2vw, 3rem);
    }

    .hero__headline {
      max-width: 18ch;
    }

    .hero__media {
      max-width: none;
      margin-inline: 0;
    }
  }

  @media (max-width: 40rem) {
    .hero__headline {
      max-width: none;
    }

    /* The eyebrow wraps onto two lines here, which left the little rule
       hanging off the end of the first one. */
    .hero__rule {
      display: none;
    }
  }

  /* ---------- About ---------- */
  /* Hosts a PhotoFrame, whose decorative wash bleeds past the frame at wider
     sizes. Clip so it can never widen the page. */
  .about {
    overflow-x: clip;
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }

  .about__credentials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .about__credentials li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Set at reading size, not as a headline figure. "30+" already appears as a
     large number in the credibility band at the top of the page; repeating it
     at that scale here read as a stutter rather than as emphasis. Both facts
     are still on the page, just no longer competing with the band. */
  .about__credential-value {
    font-size: var(--step-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.3;
  }

  .about__credential-label {
    font-size: var(--step-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* The practice supplies this headline already lower-cased; it is set as
     written rather than transformed, so editing the copy is enough. */
  .about__headline {
    font-size: var(--step-h2);
  }

  .about__body {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .about__body p {
    font-size: 1.09375rem;
    line-height: 1.72;
  }

  .about__body p:first-child {
    font-size: var(--step-lead);
    line-height: 1.6;
    color: var(--ink);
  }

  .about__link {
    margin-top: 2rem;
  }

  @media (max-width: 62rem) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__media {
      max-width: 26rem;
    }
  }

  /* ---------- Continuity ---------- */
  /* The lead is centred against the taller list of points so the leftover
     space sits evenly above and below it rather than pooling at the bottom. */
  .continuity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: center;
  }

  .continuity__body {
    margin-top: 1.25rem;
    color: var(--ink-2);
  }

  .continuity__points {
    display: grid;
    gap: 0;
  }

  .continuity__point {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .continuity__point:last-child {
    border-bottom: 1px solid var(--line);
  }

  .continuity__num {
    display: block;
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .continuity__point-title {
    font-size: var(--step-h3);
  }

  .continuity__point-body {
    margin-top: 0.5rem;
    font-size: var(--step-small);
    line-height: 1.65;
    color: var(--ink-3);
    max-width: 34rem;
  }

  @media (max-width: 62rem) {
    .continuity {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Areas of care ---------- */
  /* Four regions read best as an even 2 × 2 rather than a 3 + 1 orphan */
  .areas {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 50rem) {
    .areas {
      grid-template-columns: 1fr;
    }
  }

  .area {
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .area:hover {
    border-color: var(--accent-tint-2);
    box-shadow: var(--shadow);
  }

  .area__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .area__title a:hover {
    color: var(--accent-deep);
  }

  .area__blurb {
    margin-top: 0.65rem;
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--ink-3);
  }

  .area__list {
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }

  .area__list li {
    padding: 0.3rem 0.7rem;
    background: var(--bg-tint);
    border-radius: var(--radius-pill);
    font-size: var(--step-xs);
    color: var(--ink-2);
  }

  .areas__cta {
    margin-top: 2.5rem;
  }

  /* ---------- Insurance ---------- */
  .insurance {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 1.4rem + 3vw, 4rem);
    align-items: start;
  }

  .insurance__intro {
    margin-top: 1.15rem;
    font-size: var(--step-lead);
    line-height: 1.62;
    color: var(--ink-3);
    max-width: 32rem;
  }

  .insurance__buttons {
    margin-top: 2rem;
  }

  .insurance__plans {
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .insurance__plans-title {
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .insurance__list {
    margin-top: 1.15rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.1rem 1.5rem;
  }

  .insurance__list li {
    padding-block: 0.55rem;
    border-top: 1px solid var(--line-soft);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--ink);
  }

  .insurance__disclaimer {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 62rem) {
    .insurance {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Locations ---------- */
  .locations__header {
    margin-bottom: 2.5rem;
  }

  .locations__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  @media (max-width: 46rem) {
    .locations__grid {
      grid-template-columns: 1fr;
    }
  }

  .locations__note {
    margin-top: 0.75rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 18rem;
  }

  .locations__item {
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }

  .locations__item h3 {
    font-size: var(--step-h4);
  }

  .locations__item address {
    margin-top: 0.75rem;
    font-style: normal;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .locations__item address a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .locations__item address a:hover {
    color: var(--accent-deep);
    border-bottom-color: var(--accent);
  }

  .locations__item .link-arrow,
  .locations__item .fine {
    margin-top: 1rem;
  }

  .locations__item .link-arrow {
    display: inline-flex;
  }
</style>
