---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import Button from '../components/Button.astro';
import { forms, insurance, faqs } from '../data/patient-resources.js';
import { practice } from '../data/site.js';

const siteOrigin = Astro.site?.origin ?? 'https://welbornortho.com';
const hasDownloads = forms.items.some((item) => item.file);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Patient Resources',
      item: `${siteOrigin}/patient-resources`,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Patient Resources | New Patient Forms, Insurance & FAQ | Welborn Orthopedics"
  description="New patient forms, accepted insurance plans and answers to common questions for patients of Welborn Orthopedics in Pinole, California."
  canonical="/patient-resources"
  schema={[breadcrumbs, faqSchema]}
>
  <!-- ==================== INTRO ==================== -->
  <section class="page-hero" aria-labelledby="pr-title">
    <div class="container">
      <div class="page-hero__copy">
        <span class="eyebrow">Patient resources</span>
        <h1 id="pr-title">Everything you need before your visit.</h1>
        <p class="page-hero__lead">
          Forms to complete in advance, the insurance plans the office works with, and answers to
          the questions patients ask most often.
        </p>
      </div>

      <nav class="jump" aria-label="Jump to a section">
        <ul class="jump__list">
          <li><a class="jump__link" href="#new-patient-forms">New Patient Forms</a></li>
          <li><a class="jump__link" href="#insurance">Insurance Information</a></li>
          <li><a class="jump__link" href="#faq">Frequently Asked Questions</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- ==================== NEW PATIENT FORMS ==================== -->
  <section class="section section--surface section--rule" id="new-patient-forms" aria-labelledby="forms-heading">
    <div class="container">
      <SectionHeader
        eyebrow={forms.eyebrow}
        title={forms.headline}
        intro={forms.intro}
        id="forms-heading"
        class="reveal"
      />

      <div class="forms">
        <div class="forms__list reveal">
          <ul class="flist">
            {
              forms.items.map((item) => (
                <li class="flist__item">
                  <div class="flist__text">
                    <h3 class="flist__name">
                      {item.file ? <a href={item.file} download>{item.name}</a> : item.name}
                    </h3>
                    <p class="flist__desc">{item.description}</p>
                  </div>
                  {item.file ? (
                    <a class="flist__action" href={item.file} download>
                      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path
                          d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13h11"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      PDF
                      <span class="visually-hidden">— download {item.name}</span>
                    </a>
                  ) : (
                    <span class="flist__pending">At the office</span>
                  )}
                </li>
              ))
            }
          </ul>

          {!hasDownloads && <p class="forms__fallback">{forms.fallbackNote}</p>}
        </div>

        <div class="forms__bring reveal">
          <div class="panel panel--tint">
            <h3 class="forms__bring-title">{forms.bring.heading}</h3>
            <ul class="list-check forms__bring-list">
              {forms.bring.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== INSURANCE ==================== -->
  <section class="section section--tint section--rule" id="insurance" aria-labelledby="insurance-heading">
    <div class="container">
      <div class="ins">
        <div class="ins__copy reveal">
          <span class="eyebrow">{insurance.eyebrow}</span>
          <h2 id="insurance-heading">{insurance.headline}</h2>
          <p class="ins__intro">{insurance.intro}</p>

          <div class="btn-row ins__buttons">
            <Button href={`tel:${practice.phoneHref}`}>
              {insurance.ctaLabel} — {practice.phone}
            </Button>
          </div>

          <div class="ins__wc">
            <h3 class="ins__wc-title">{insurance.workersComp.heading}</h3>
            <p class="ins__wc-body">{insurance.workersComp.body}</p>
          </div>
        </div>

        <div class="ins__panel reveal" style="--reveal-delay: 90ms">
          <h3 class="ins__panel-title">Accepted plans include</h3>
          <ul class="ins__list">
            {insurance.plans.map((plan) => <li>{plan}</li>)}
          </ul>
          <p class="fine ins__disclaimer">{insurance.disclaimer}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <SectionHeader
        eyebrow={faqs.eyebrow}
        title={faqs.headline}
        id="faq-heading"
        class="reveal"
      />

      <div class="faq reveal">
        {
          faqs.items.map((item) => (
            <details class="faq__item" name="faq">
              <summary class="faq__q">
                <span>{item.q}</span>
                <svg class="faq__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path
                    d="M4 6.5 8 10.5 12 6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="faq__a">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.75rem, 2rem + 4vw, 5rem) clamp(2.5rem, 2rem + 3vw, 4rem);
    background:
      radial-gradient(70% 130% at 90% 0%, rgba(51, 86, 107, 0.07) 0%, transparent 60%),
      var(--bg);
  }

  .page-hero__copy {
    max-width: 44rem;
  }

  .page-hero h1 {
    font-size: var(--step-h1);
    letter-spacing: -0.028em;
  }

  .page-hero__lead {
    margin-top: 1.25rem;
    font-size: var(--step-lead);
    line-height: 1.62;
    color: var(--ink-3);
  }

  .jump {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .jump__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .jump__link {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    min-height: 44px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--step-small);
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .jump__link:hover {
    border-color: var(--accent);
    color: var(--accent-deep);
  }

  /* ---------- Forms ---------- */
  .forms {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 1.4rem + 3vw, 4rem);
    align-items: start;
  }

  .flist__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .flist__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .flist__name {
    font-size: var(--step-h4);
  }

  .flist__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .flist__name a:hover {
    color: var(--accent-deep);
  }

  .flist__desc {
    margin-top: 0.3rem;
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--ink-3);
  }

  .flist__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.55rem 1rem;
    min-height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--step-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .flist__action:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
  }

  .flist__action svg {
    width: 15px;
    height: 15px;
  }

  .flist__pending {
    flex-shrink: 0;
    font-size: var(--step-xs);
    letter-spacing: 0.06em;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .forms__fallback {
    margin-top: 1.5rem;
    font-size: var(--step-small);
    line-height: 1.65;
    color: var(--ink-3);
    max-width: 36rem;
  }

  .forms__bring-title {
    font-size: var(--step-h4);
    margin-bottom: 1.15rem;
  }

  .forms__bring-list li {
    font-size: var(--step-small);
    line-height: 1.6;
  }

  @media (max-width: 62rem) {
    .forms {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Insurance ---------- */
  .ins {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 1.4rem + 3vw, 4rem);
    align-items: start;
  }

  .ins__intro {
    margin-top: 1.15rem;
    font-size: var(--step-lead);
    line-height: 1.62;
    color: var(--ink-3);
    max-width: 32rem;
  }

  .ins__buttons {
    margin-top: 2rem;
  }

  .ins__wc {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    max-width: 32rem;
  }

  .ins__wc-title {
    font-size: var(--step-h4);
  }

  .ins__wc-body {
    margin-top: 0.6rem;
    font-size: var(--step-small);
    line-height: 1.7;
    color: var(--ink-3);
  }

  .ins__panel {
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .ins__panel-title {
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ins__list {
    margin-top: 1.15rem;
  }

  .ins__list li {
    padding-block: 0.65rem;
    border-top: 1px solid var(--line-soft);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--ink);
  }

  .ins__disclaimer {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 62rem) {
    .ins {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQ ---------- */
  .faq {
    max-width: 48rem;
  }

  .faq__item {
    border-top: 1px solid var(--line);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    font-size: var(--step-h4);
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--accent-deep);
  }

  .faq__icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  .faq__a {
    padding-bottom: 1.5rem;
    max-width: 42rem;
  }

  .faq__a p {
    line-height: 1.75;
    color: var(--ink-2);
  }
</style>
