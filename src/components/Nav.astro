---
import { navigation, primaryCta, practice } from '../data/site.js';
import Button from './Button.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href === '/') return path === '/';
  if (href === '/conditions-treatments') {
    return (
      path === href || path.startsWith('/conditions/') || path.startsWith('/treatments/')
    );
  }
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header" data-header>
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label={`${practice.name} — home`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-opacity="0.28" />
        <path
          d="M9 21.5c0-5 3.2-8.2 7-8.2s7 3.2 7 8.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
        />
        <path
          d="M12.4 10.6a5 5 0 0 1 7.2 0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-opacity="0.55"
        />
      </svg>
      <span class="brand__text">
        <span class="brand__name">Welborn Orthopedics</span>
        <span class="brand__sub">{practice.doctor.specialty}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', isActive(item.href) && 'is-active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={`tel:${practice.phoneHref}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M5.2 2.6 6.6 5 5.3 6.6a8.4 8.4 0 0 0 4.1 4.1L11 9.4l2.4 1.4-.5 2.3-1.6.4C7.5 13.3 2.7 8.5 2 4.7l.4-1.6z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        <span class="visually-hidden">Call the office at </span>{practice.phone}
      </a>
      <Button href={primaryCta.href} class="site-header__cta">{primaryCta.label}</Button>
    </div>

    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-toggle__label">Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Mobile">
      <ul class="mobile-menu__list">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mobile-menu__link', isActive(item.href) && 'is-active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__actions">
        <Button href={primaryCta.href} wide>{primaryCta.label}</Button>
        <Button href={`tel:${practice.phoneHref}`} variant="secondary" wide>
          Call {practice.phone}
        </Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 250, 248, 0.88);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .site-header.is-stuck {
    border-bottom-color: var(--line);
    background: rgba(251, 250, 248, 0.95);
    box-shadow: 0 1px 20px rgba(20, 25, 31, 0.05);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  /* Brand ---------------------------------------------------------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand__mark {
    width: 34px;
    height: 34px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .brand__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.15rem;
  }

  /* Desktop nav ---------------------------------------------------------- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 0.1rem + 1vw, 1.5rem);
  }

  .site-nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0.15rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-nav__link.is-active {
    color: var(--ink);
    font-weight: 600;
  }

  /* Actions -------------------------------------------------------------- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__phone svg {
    width: 15px;
    height: 15px;
    color: var(--accent);
  }

  .site-header__phone:hover {
    color: var(--accent-deep);
  }

  .site-header__cta {
    padding: 0.72em 1.3em;
    min-height: 42px;
    font-size: 0.875rem;
  }

  /* Mobile toggle -------------------------------------------------------- */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    margin-right: -0.3rem;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    min-height: 44px;
  }

  .menu-toggle__bars {
    position: relative;
    display: block;
    width: 16px;
    height: 10px;
  }

  .menu-toggle__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .menu-toggle__bars span:first-child {
    top: 0;
  }
  .menu-toggle__bars span:last-child {
    bottom: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* Mobile menu ---------------------------------------------------------- */
  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .mobile-menu__list {
    padding-block: 0.5rem 0.25rem;
  }

  .mobile-menu__link {
    display: block;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line-soft);
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-menu__link.is-active {
    color: var(--accent);
    font-weight: 650;
  }

  .mobile-menu__actions {
    display: grid;
    gap: 0.65rem;
    padding-block: 1.25rem 1.75rem;
  }

  /* Breakpoint ----------------------------------------------------------- */
  @media (max-width: 1079px) {
    .site-nav,
    .site-header__actions {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 1200px) and (min-width: 1080px) {
    .site-header__phone {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .brand__sub {
      display: none;
    }
    .menu-toggle__label {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close the panel if the viewport grows past the mobile breakpoint.
    const wide = window.matchMedia('(min-width: 1080px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Hairline border appears once the page has scrolled.
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-stuck', window.scrollY > 8);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }
</script>
