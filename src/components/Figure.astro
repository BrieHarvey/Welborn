---
/**
 * Figure — photography slot.
 *
 * While `src` is empty this renders the practice's own brand panel (see
 * BrandPanel.astro), which is designed to stand on its own rather than look
 * like a missing image. Set `src` to a real photograph — for example
 * "/images/dr-welborn-portrait.jpg" — and the panel is replaced by a
 * responsive, lazy-loaded photograph. Nothing else needs to change.
 *
 * `note` describes the photograph that belongs here. It is not shown to
 * visitors; it is written into the page source as a comment for whoever adds
 * the photography later.
 *
 * See README → "Swapping in photography".
 */
import BrandPanel from './BrandPanel.astro';

interface Props {
  src?: string;
  alt: string;
  /** Description of the intended photograph, for developers. Not displayed. */
  note?: string;
  /** Content shown on the brand panel while there is no photograph. */
  panel?: {
    art?: 'wide' | 'portrait';
    kicker?: string;
    title?: string;
    sub?: string;
  };
  ratio?: string;
  /** Set true for an image visible on first paint (the hero). */
  eager?: boolean;
  width?: number;
  height?: number;
  class?: string;
}

const {
  src = '',
  alt,
  note = '',
  panel = {},
  ratio = '4 / 3',
  eager = false,
  width = 1200,
  height = 900,
  class: className = '',
} = Astro.props;
---

{
  src ? (
    <img
      class:list={['figure', className]}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      style={`aspect-ratio: ${ratio};`}
    />
  ) : (
    <Fragment>
      {note && <Fragment set:html={`<!-- Photography slot: ${note} -->`} />}
      <BrandPanel
        art={panel.art ?? 'wide'}
        ratio={ratio}
        kicker={panel.kicker}
        title={panel.title}
        sub={panel.sub}
        eager={eager}
        class={className}
      />
    </Fragment>
  )
}

<style>
  .figure {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
</style>
