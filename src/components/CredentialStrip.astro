---
/**
 * CredentialStrip — the quiet credibility band beneath the hero.
 * Content comes from `credentials` in src/data/content.js.
 */
import { credentials } from '../data/content.js';
---

<section class="cred" aria-label="Practice credentials">
  <div class="container">
    <ul class="cred__list">
      {
        credentials.map((item) => (
          <li class="cred__item">
            <span class="cred__dot" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cred {
    background: var(--surface);
    border-block: 1px solid var(--line);
    padding-block: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }

  .cred__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.15rem clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .cred__item {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }

  .cred__dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    /* The logo's green, used here and in the artwork — the one place a
       second brand colour appears in the interface. */
    background: var(--brand-green);
    transform: translateY(-1px);
  }

  /* Hairline separators between items on wider screens */
  @media (min-width: 60rem) {
    .cred__list {
      grid-template-columns: repeat(4, 1fr);
    }

    .cred__item + .cred__item {
      padding-left: clamp(1.5rem, 1rem + 2vw, 3rem);
      margin-left: calc(-1 * clamp(1.5rem, 1rem + 2vw, 3rem));
      border-left: 1px solid var(--line);
    }
  }
</style>
