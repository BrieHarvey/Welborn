---
/**
 * CredentialStrip — the credibility band that closes the hero.
 *
 * It is deliberately part of the hero rather than a separate band: it sits on
 * the same background, separated by a hairline, so the page opens as one
 * composition instead of a headline followed by a detached strip.
 *
 * Content comes from `credentials` in src/data/content.js. The two proof points
 * that lead with a number are set large; the two that are statements are set at
 * reading size beside them.
 */
import { credentials } from '../data/content.js';
---

<section class="cred" aria-label="Practice credentials">
  <div class="container cred__inner">
    <dl class="cred__figures">
      {
        credentials.figures.map((item) => (
          <div class="cred__figure">
            <dt class="cred__value">{item.figure}</dt>
            <dd class="cred__label">{item.label}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="cred__statements">
      {
        credentials.statements.map((statement) => (
          <li class="cred__statement">
            <svg class="cred__tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="9" fill="currentColor" fill-opacity="0.14" />
              <path
                d="M6 10.4 8.8 13.2 14.2 7.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{statement}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cred {
    padding-block: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .cred__inner {
    display: grid;
    /* The figures size to their content and the statements take the rest, so
       there is no dead space stranded beside a short number. */
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1.2rem + 3vw, 4rem);
  }

  /* The list stays a <dl> for semantics but lays its children out on the grid
     above rather than nesting a second grid inside one column. */
  .cred__figures {
    display: contents;
  }

  .cred__value {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--accent);
    /* Lining but NOT tabular: tabular numerals give the comma a full digit
       slot, which renders "4,000" as "4 , 000". */
    font-variant-numeric: lining-nums proportional-nums;
  }

  .cred__label {
    margin: 0.6rem 0 0;
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* ---- The two statements ---- */
  .cred__statements {
    display: grid;
    gap: 0.9rem;
    padding-left: clamp(2rem, 1.2rem + 3vw, 4rem);
    border-left: 1px solid var(--line);
  }

  .cred__statement {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }

  .cred__tick {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 0.1em;
    /* The logo's green — the one place a second brand colour appears in the
       interface, so it stays a brand signal rather than decoration. */
    color: var(--brand-green-deep);
  }

  /* ---- Responsive ---- */
  @media (max-width: 62rem) {
    .cred__inner {
      grid-template-columns: auto auto;
      gap: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem) clamp(2rem, 1.4rem + 3vw, 3.5rem);
      justify-content: start;
    }

    .cred__statements {
      grid-column: 1 / -1;
      padding-left: 0;
      padding-top: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 30rem) {
    .cred__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
