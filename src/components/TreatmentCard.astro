---
/**
 * TreatmentCard — one condition or procedure in a grouped list.
 * The whole card is clickable, but only the title is a real link, so screen
 * readers and keyboard users get one clean, well-labelled target.
 */
interface Props {
  title: string;
  href: string;
  summary?: string;
  kind?: 'condition' | 'treatment';
}

const { title, href, summary, kind = 'condition' } = Astro.props;
---

<article class="tcard">
  <h3 class="tcard__title">
    <a href={href} class="tcard__link">{title}</a>
  </h3>
  {summary && <p class="tcard__summary">{summary}</p>}
  <span class="tcard__kind">{kind === 'treatment' ? 'Procedure' : 'Condition'}</span>
</article>

<style>
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .tcard:hover {
    border-color: var(--accent-tint-2);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .tcard:focus-within {
    border-color: var(--accent);
  }

  .tcard__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.008em;
    line-height: 1.35;
  }

  .tcard__link {
    color: var(--ink);
    text-decoration: none;
  }

  /* Expands the link's hit area to the whole card */
  .tcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tcard:hover .tcard__link {
    color: var(--accent-deep);
  }

  .tcard__summary {
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--ink-3);
    margin-bottom: 0.25rem;
  }

  .tcard__kind {
    margin-top: auto;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.75;
  }
</style>
