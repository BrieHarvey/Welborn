---
/**
 * Logo — the Welborn Orthopedics logo.
 *
 * The practice supplied the logo as a stacked lockup: the mark above the
 * words. That shape is too tall for a sticky header, so the same artwork is
 * also generated as a horizontal lockup and as the mark on its own. All of
 * them come from one source file — see scripts/trace-logo.py and the README
 * section "Brand and artwork".
 *
 * variant  'horizontal'  mark beside the words  — the site header
 *          'stacked'     the supplied lockup    — where height allows
 *          'mark'        the mark alone         — small spaces, favicons
 *
 * tone     'colour'  the logo as supplied — for white and light backgrounds
 *          'tile'    the logo on a white tile — for dark backgrounds
 *
 * The mark relies on white gaps between the spine and the cross, so it cannot
 * simply be dropped onto a dark panel: the spine would run into the cross and
 * the shape would be lost. `tone="tile"` is the fix, and it keeps the brand
 * colours exact rather than flattening the logo to one colour.
 */
interface Props {
  variant?: 'horizontal' | 'stacked' | 'mark';
  tone?: 'colour' | 'tile';
  /** Rendered height in pixels. Width follows the artwork's proportions. */
  height?: number;
  /** Set true for the logo in the page header, which is visible immediately. */
  eager?: boolean;
  class?: string;
}

const {
  variant = 'horizontal',
  tone = 'colour',
  height = 46,
  eager = false,
  class: className = '',
} = Astro.props;

// Intrinsic sizes of the generated artwork, so the browser reserves the right
// space before the SVG arrives and the header never shifts.
const ART = {
  horizontal: { src: '/images/logo-horizontal.svg', w: 405, h: 100 },
  stacked: { src: '/images/logo-stacked.svg', w: 845, h: 857 },
  mark: { src: '/images/logo-mark.svg', w: 600, h: 645 },
};

const art = ART[variant];
const width = Math.round((art.w / art.h) * height);
---

<span class:list={['logo', `logo--${tone}`, className]}>
  <img
    class="logo__art"
    src={art.src}
    alt="Welborn Orthopedics"
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</span>

<style>
  .logo {
    display: inline-flex;
    flex: none;
    /* Never stretch inside a flex or grid parent — a logo has one size. */
    align-self: flex-start;
  }

  .logo__art {
    display: block;
    height: auto;
  }

  /* A white tile so the logo keeps its own colours on a dark band. */
  .logo--tile {
    padding: 0.6em 0.7em;
    background: #fff;
    border-radius: var(--radius);
  }
</style>
